{
  "name": "standcast",
  "version": "0.11.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/adapters/*"
  ],
  "scripts": {
    "test": "bun test",
    "db:migrate": "bun packages/db/src/migrate-cli.ts",
    "api": "bun run apps/api/src/main.ts",
    "worker": "bun run apps/worker/src/main.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "build:cli": "bun scripts/build-cli.ts",
    "docs:dev": "vitepress dev docs/site",
    "docs:build": "vitepress build docs/site",
    "docs:og": "bun scripts/docs-og-render.ts",
    "check-docs": "bun scripts/check-docs.ts",
    "check-pins": "bun scripts/check-pins.ts",
    "check-deps": "bun scripts/check-deps.ts",
    "check-layers": "bun scripts/check-layers.ts",
    "web:dev": "bun run --cwd apps/web dev",
    "web:build": "bun run --cwd apps/web build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "1.64.1",
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/bun": "^1.4.4",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vitepress": "1.6.4",
    "vitepress-plugin-llms": "1.14.0"
  }
}
